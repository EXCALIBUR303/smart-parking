# Environment variables the API reads. Export them in your shell, or set them
# in your host's dashboard (e.g. Vercel). The API does not read a .env file.
# None are needed for a local demo: without them the API connects to the local
# PostgreSQL database "smartpark" over its Unix socket.

# Full connection string. Required for any hosted database (e.g. Supabase).
# SMARTPARK_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Local database name, used only when SMARTPARK_DATABASE_URL is not set.
# SMARTPARK_DB=smartpark

# Secret used to sign sign-in tokens. REQUIRED in any deployment; generate one
# with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# SMARTPARK_JWT_SECRET=
